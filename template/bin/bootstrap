#!/bin/sh
# Provision this workspace. All logic lives in `aw`; this is only a shim.
set -eu

if ! command -v aw >/dev/null 2>&1; then
	echo "aw not found on PATH." >&2
	echo "Build and install it from the agentic-workspace repo, then re-run." >&2
	exit 1
fi

exec aw bootstrap "$(cd "$(dirname "$0")/.." && pwd)"
